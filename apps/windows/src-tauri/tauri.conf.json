{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QC Voice Control",
  "version": "0.1.0",
  "identifier": "com.tonyxmelon.qcvoicecontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QC Voice Control",
        "width": 1440,
        "height": 980,
        "minWidth": 920,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
