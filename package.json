{
  "name": "ndsp-qc-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/windows",
    "packages/typescript/*"
  ],
  "scripts": {
    "dev:windows": "npm run dev --workspace @ndsp-qc/windows",
    "build:windows": "npm run build --workspace @ndsp-qc/windows",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "tauri:dev": "npm run tauri:dev --workspace @ndsp-qc/windows",
    "tauri:build": "npm run tauri:build --workspace @ndsp-qc/windows",
    "test:assistant": "npm run test:frontend",
    "test:frontend": "node --experimental-strip-types --test tests/assistant.test.ts tests/footswitch-leds.test.ts tests/voice.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
