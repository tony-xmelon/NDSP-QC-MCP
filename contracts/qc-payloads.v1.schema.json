{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qc-control.local/contracts/qc-payloads.v1.schema.json",
  "title": "QC shared application payloads v1",
  "description": "Canonical snapshots, native state events, editor details, and action results shared by Rust, TypeScript, and Python.",
  "x-generate": ["GridBlock", "FootswitchState", "GridRoute", "ModeSlot", "BypassUpdate", "QcStateUpdate", "ScalePoint", "BlockParameter", "BlockDetails", "PresetSnapshot", "DeviceActionResult"],
  "x-rust-types": ["GridBlock", "GridRoute", "ModeSlot", "BypassUpdate", "QcStateUpdate", "ScalePoint", "BlockParameter", "BlockDetails"],
  "$defs": {
    "GridBlock": {"type":"object","required":["id","name","kind","row","column"],"properties":{"id":{"type":"string"},"modelId":{"type":"integer"},"categoryId":{"type":"integer"},"name":{"type":"string"},"kind":{"enum":["input","utility","capture","amp","cab","mod","delay","reverb","output"]},"category":{"type":"string"},"plugin":{"type":"boolean"},"pluginId":{"type":"string"},"row":{"type":"integer"},"column":{"type":"integer"},"bypassed":{"type":"boolean"},"color":{"type":"string"},"glyph":{"type":"string"},"footswitch":{"type":"integer"},"footswitchOrder":{"type":"integer"}}},
    "FootswitchState": {"type":"object","required":["index","active","assigned","color"],"properties":{"index":{"type":"integer"},"active":{"type":"boolean"},"assigned":{"type":"boolean"},"color":{"type":"string"},"momentary":{"type":"boolean"},"label":{"type":"string"}}},
    "GridRoute": {"type":"object","required":["row","input","output"],"properties":{"row":{"type":"integer"},"inputId":{"type":"integer"},"outputId":{"type":"integer"},"input":{"type":"string"},"output":{"type":"string"},"splitColumn":{"type":"integer","x-rust-type":"i32"},"mixColumn":{"type":"integer","x-rust-type":"i32"}}},
    "ModeSlot": {"type":"object","required":["slot","label","mode"],"properties":{"slot":{"enum":[0,1,2],"x-rust-type":"u32"},"label":{"type":"string"},"mode":{"enum":["PRESET","SCENE","STOMP","HYBRID"]}}},
    "BypassUpdate": {"type":"object","required":["row","column","bypassed"],"properties":{"row":{"type":"integer"},"column":{"type":"integer"},"bypassed":{"type":"boolean"}}},
    "QcStateUpdate": {"type":"object","required":["kind"],"properties":{"kind":{"enum":["scene","dirty","master","sceneLabel","sceneColor","position","preset","bypass","bypassBatch","mode","tempo","parameter"]},"activeScene":{"type":"integer"},"dirty":{"type":"boolean"},"masterVolume":{"type":"number","x-rust-type":"f32"},"index":{"type":"integer"},"label":{"type":"string"},"color":{"type":"string"},"setlistKey":{"type":"string"},"position":{"type":"integer"},"isFactory":{"type":"boolean"},"presetName":{"type":"string"},"tempo":{"type":"integer"},"tempoLedEnabled":{"type":"boolean"},"scenes":{"type":"array","items":{"type":"string"}},"sceneColors":{"type":"array","items":{"type":"string"}},"blocks":{"type":"array","items":{"$ref":"#/$defs/GridBlock"}},"routes":{"type":"array","items":{"$ref":"#/$defs/GridRoute"}},"mode":{"enum":["PRESET","SCENE","STOMP","HYBRID"]},"modeSlots":{"type":"array","items":{"$ref":"#/$defs/ModeSlot"}},"footswitchModes":{"type":"array","items":{"enum":["PRESET","SCENE","STOMP"]}},"row":{"type":"integer"},"column":{"type":"integer"},"bypassed":{"type":"boolean"},"bypassUpdates":{"type":"array","items":{"$ref":"#/$defs/BypassUpdate"}},"parameterIndex":{"type":"integer"},"normalizedValue":{"type":"number","x-rust-type":"f32"},"catalogRefresh":{"type":"boolean"},"observedAt":{"type":"integer","x-rust-type":"u64"}}},
    "ScalePoint": {"type":"object","required":["normalized","real"],"properties":{"normalized":{"type":"number"},"real":{"type":"number"}}},
    "BlockParameter": {"type":"object","required":["index","displayPosition","name","normalizedValue","displayValue","units","type","minimum","maximum","valueScale","scalePoints","scaleKnown","sceneMode","options","writable","enabled","expressionAssignable","wireValueKind"],"properties":{"index":{"type":"integer"},"displayPosition":{"type":"integer"},"name":{"type":"string"},"normalizedValue":{"type":"number","x-nullable":true},"displayValue":{"type":"string"},"units":{"type":"string"},"type":{"type":"string"},"minimum":{"type":"number"},"maximum":{"type":"number"},"valueScale":{"type":"string"},"scaleExponent":{"type":"number","x-nullable":true},"scalePoints":{"type":"array","items":{"$ref":"#/$defs/ScalePoint"}},"scaleKnown":{"type":"boolean"},"displayPrecision":{"type":"integer","x-nullable":true},"minimumLabel":{"type":"string","x-nullable":true},"midpointLabel":{"type":"string","x-nullable":true},"maximumLabel":{"type":"string","x-nullable":true},"steps":{"type":"integer","x-nullable":true},"sceneMode":{"type":"boolean"},"options":{"type":"array","items":{"type":"string"}},"writable":{"type":"boolean"},"enabled":{"type":"boolean"},"expressionAssignable":{"type":"boolean"},"linkedSceneMode":{"type":"integer","x-nullable":true},"expression":{"type":"integer","x-rust-type":"i32","x-nullable":true},"expressionMinimum":{"type":"number","x-rust-type":"f32","x-nullable":true},"expressionMaximum":{"type":"number","x-rust-type":"f32","x-nullable":true},"ledValue":{"type":"number","x-rust-type":"f32","x-nullable":true},"wireValueKind":{"type":"string"}}},
    "BlockDetails": {"type":"object","required":["row","column","modelId","name","category","scene","parameters"],"properties":{"row":{"type":"integer"},"column":{"type":"integer"},"modelId":{"type":"integer"},"name":{"type":"string"},"category":{"type":"string"},"scene":{"type":"integer"},"parameters":{"type":"array","items":{"$ref":"#/$defs/BlockParameter"}}}},
    "PresetSnapshot": {"type":"object","required":["deviceName","presetName","presetLocation","presetPosition","setlistKey","setlistName","mode","activeScene","scenes","blocks","routes","tempo","masterVolume","dirty"],"properties":{"deviceName":{"type":"string"},"presetName":{"type":"string"},"presetLocation":{"type":"string"},"presetPosition":{"type":"integer"},"setlistKey":{"type":"string"},"setlistName":{"type":"string"},"mode":{"enum":["PRESET","SCENE","STOMP","HYBRID"]},"modeSlots":{"type":"array","items":{"$ref":"#/$defs/ModeSlot"}},"footswitchModes":{"type":"array","items":{"enum":["PRESET","SCENE","STOMP"]}},"activeScene":{"type":"integer"},"scenes":{"type":"array","items":{"type":"string"}},"sceneColors":{"type":"array","items":{"type":"string"}},"footswitchStates":{"type":"array","items":{"$ref":"#/$defs/FootswitchState"}},"blocks":{"type":"array","items":{"$ref":"#/$defs/GridBlock"}},"routes":{"type":"array","items":{"$ref":"#/$defs/GridRoute"}},"tempo":{"type":"integer"},"tempoLedEnabled":{"type":"boolean"},"tempoPulseEpochMs":{"type":"integer","x-rust-type":"u64"},"masterVolume":{"type":"number"},"dirty":{"type":"boolean"}}},
    "DeviceActionResult": {"type":"object","required":["detail"],"properties":{"detail":{"type":"string"},"snapshot":{"$ref":"#/$defs/PresetSnapshot"}}}
  }
}
