{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qc-voice-control.local/contracts/gateway.v1.schema.json",
  "title": "QC Gateway JSON-RPC v1",
  "description": "Envelope and domain payloads exchanged with the private device gateway.",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer", "minimum": 1 },
        "method": {
          "enum": [
            "system.status",
            "device.reconnect",
            "device.resetSession",
            "device.snapshot",
            "device.selectScene",
            "device.toggleBypass",
            "device.listPresets",
            "device.navigateBank",
            "device.recallPreset",
            "device.reloadPreset",
            "device.blockDetails",
            "device.setParameter",
            "device.listPresetSlots",
            "device.savePresetAs",
            "device.showTuner",
            "device.showGigView"
          ]
        },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer", "minimum": 1 },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
