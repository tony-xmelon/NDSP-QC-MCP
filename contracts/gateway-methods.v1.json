{
  "version": 1,
  "apiVersion": 2,
  "capabilities": ["modelRepoParameterMetadata", "nativeBroker", "nativeStateEvents", "nativeDeviceIdentity", "nativeRemoteScreen"],
  "pythonCapabilities": ["modelRepoParameterMetadata", "nativeStateEvents", "nativeDeviceIdentity", "nativeRemoteScreen"],
  "androidDispatch": {
    "SYSTEM": ["system.status"],
    "RECONNECT": ["device.reconnect", "device.resetSession"],
    "DISCONNECT": ["device.disconnect"],
    "SNAPSHOT": ["device.snapshot"],
    "STATE_EVENTS": ["device.stateEvents"],
    "TEMPO_CLOCK": ["device.tempoClock"],
    "MODELS": ["device.listModels"],
    "CORRELATED_READ": ["device.identity", "device.inhibitedModules", "device.presetScreenshot", "device.captureScreen"],
    "PRESET_LIBRARY": ["device.listPresets", "device.listPresetFolders", "device.listPresetSlots"],
    "MASTER_VOLUME": ["device.masterVolume"],
    "BLOCK_DETAILS": ["device.blockDetails"],
    "SET_DEVICE_NAME": ["device.setDeviceName"],
    "TAP_SCREEN": ["device.tapScreen"],
    "BACKUP": ["device.createBackup"],
    "PREVIEW_PARAMETER": ["device.previewParameter"],
    "PLANNED_WRITE": ["device.undo", "device.redo", "device.selectScene", "device.toggleBypass", "device.moveBlock", "device.addBlock", "device.removeBlock", "device.setBlockFootswitch", "device.setChainInput", "device.setChainOutput", "device.setChainSplit", "device.setParameter", "device.setTempo", "device.setMasterVolume", "device.pressFootswitch", "device.tapTempo", "device.selectModeSlot", "device.showTuner", "device.showGigView"],
    "PRESET_WRITE": ["device.navigateBank", "device.recallPreset", "device.reloadPreset"],
    "PERSISTENT_WRITE": ["device.savePresetAs", "device.copyPreset", "device.renameCurrentPreset"]
  },
  "methods": [
    { "rpc": "system.status", "kind": "system", "client": "runtimeStatus", "tauri": "runtime_status" },
    { "rpc": "device.reconnect", "target": "reconnect", "client": "reconnect", "tauri": "reconnect_device", "args": [] },
    { "rpc": "device.resetSession", "target": "reset_session", "client": "resetSession", "tauri": "reset_device_session", "args": [] },
    { "rpc": "device.disconnect", "target": "disconnect", "client": "disconnect", "tauri": "disconnect_device", "args": [] },
    { "rpc": "device.snapshot", "target": "snapshot", "client": "currentSnapshot", "tauri": "current_snapshot", "args": [] },
    { "rpc": "device.stateEvents", "target": "state_events", "client": "currentStateEvents", "tauri": "current_state_events", "args": [{ "name": "afterSequence", "default": 0 }, { "name": "limit", "default": 256 }] },
    { "rpc": "device.tempoClock", "target": "tempo_clock_state", "client": "currentTempoClock", "tauri": "current_tempo_clock", "args": [] },
    { "rpc": "device.listModels", "target": "list_models", "client": "listModels", "tauri": "list_models", "args": [] },
    { "rpc": "device.identity", "target": "identity", "client": "identity", "tauri": "device_identity", "args": [] },
    { "rpc": "device.setDeviceName", "target": "set_device_name", "client": "setDeviceName", "tauri": "set_device_name", "args": ["name"] },
    { "rpc": "device.undo", "target": "undo", "client": "undo", "tauri": "undo_device", "args": [] },
    { "rpc": "device.redo", "target": "redo", "client": "redo", "tauri": "redo_device", "args": [] },
    { "rpc": "device.inhibitedModules", "target": "inhibited_modules", "client": "inhibitedModules", "tauri": "inhibited_modules", "args": [] },
    { "rpc": "device.presetScreenshot", "target": "preset_screenshot", "client": "presetScreenshot", "tauri": "preset_screenshot", "args": ["folderName", "position", { "name": "isFactory", "default": false }] },
    { "rpc": "device.captureScreen", "target": "capture_screen", "client": "captureScreen", "tauri": "capture_screen", "args": [] },
    { "rpc": "device.tapScreen", "target": "tap_screen", "client": "tapScreen", "tauri": "tap_screen", "args": ["x", "y"] },
    { "rpc": "device.selectScene", "target": "select_scene", "client": "selectScene", "tauri": "select_scene", "args": ["scene", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.toggleBypass", "target": "toggle_bypass", "client": "toggleBypass", "tauri": "toggle_bypass", "args": ["row", "column", "expectedScene", "expectedBypassed", "desiredBypassed", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.moveBlock", "target": "move_block", "client": "moveBlock", "tauri": "move_block", "args": ["row", "fromColumn", "toColumn", "expectedModelId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.addBlock", "target": "add_block", "client": "addBlock", "tauri": "add_block", "args": ["row", "column", "modelId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.removeBlock", "target": "remove_block", "client": "removeBlock", "tauri": "remove_block", "args": ["row", "column", "expectedModelId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setBlockFootswitch", "target": "set_block_footswitch", "client": "setBlockFootswitch", "tauri": "set_block_footswitch", "args": ["row", "column", "footswitch", "expectedFootswitch", "expectedModelId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setChainInput", "target": "set_chain_input", "client": "setChainInput", "tauri": "set_chain_input", "args": ["row", "inputId", "expectedInputId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setChainOutput", "target": "set_chain_output", "client": "setChainOutput", "tauri": "set_chain_output", "args": ["row", "outputId", "expectedOutputId", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setChainSplit", "target": "set_chain_split", "client": "setChainSplit", "tauri": "set_chain_split", "args": ["row", "splitColumn", "mixColumn", "expectedSplitColumn", "expectedMixColumn", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.listPresets", "target": "list_presets", "client": "listPresets", "tauri": "list_presets", "args": [{ "name": "refresh", "default": false }, "setlistKey"] },
    { "rpc": "device.listPresetFolders", "target": "list_preset_folders", "client": "listPresetFolders", "tauri": "list_preset_folders", "args": [{ "name": "refresh", "default": false }] },
    { "rpc": "device.navigateBank", "target": "navigate_bank", "client": "navigateBank", "tauri": "navigate_bank", "args": ["direction", { "name": "expectedPresetName", "default": "" }, "expectedPosition"] },
    { "rpc": "device.recallPreset", "target": "recall_preset", "client": "recallPreset", "tauri": "recall_preset", "args": ["setlistKey", "position", { "name": "expectedPresetName", "default": "" }, "expectedPosition"] },
    { "rpc": "device.reloadPreset", "target": "reload_preset", "client": "reloadPreset", "tauri": "reload_preset", "args": [{ "name": "expectedPresetName", "default": "" }, "expectedPosition"] },
    { "rpc": "device.blockDetails", "target": "block_details", "client": "blockDetails", "tauri": "block_details", "args": ["row", "column", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.previewParameter", "target": "preview_parameter", "client": "previewParameter", "tauri": "preview_parameter", "args": ["row", "column", "parameterIndex", "value", "expectedScene", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setParameter", "target": "set_parameter", "client": "setParameter", "tauri": "set_parameter", "args": ["row", "column", "parameterIndex", "value", "expectedValue", "expectedScene", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setTempo", "target": "set_tempo", "client": "setTempo", "tauri": "set_tempo", "args": ["bpm", "expectedTempo", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.setMasterVolume", "target": "set_master_volume", "client": "setMasterVolume", "tauri": "set_master_volume", "args": ["value", "expectedValue"] },
    { "rpc": "device.masterVolume", "target": "master_volume_state", "client": "currentMasterVolume", "tauri": "current_master_volume", "args": [] },
    { "rpc": "device.pressFootswitch", "target": "press_footswitch", "client": "pressFootswitch", "tauri": "press_footswitch", "args": ["index", "expectedMode", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.tapTempo", "target": "tap_tempo", "client": "tapTempo", "tauri": "tap_tempo", "args": ["expectedMode", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.selectModeSlot", "target": "select_mode_slot", "client": "selectModeSlot", "tauri": "select_mode_slot", "args": ["slot", { "name": "expectedPresetName", "default": "" }] },
    { "rpc": "device.listPresetSlots", "target": "list_preset_slots", "client": "listPresetSlots", "tauri": "list_preset_slots", "args": [] },
    { "rpc": "device.savePresetAs", "target": "save_preset_as", "client": "savePresetAs", "tauri": "save_preset_as", "args": ["setlistKey", "position", "name", { "name": "expectedPresetName", "default": "" }, "expectedPosition", { "name": "confirmOverwrite", "default": false }] },
    { "rpc": "device.copyPreset", "target": "copy_preset", "client": "copyPreset", "tauri": "copy_preset", "args": ["sourceSetlistKey", "sourcePosition", { "name": "sourceName", "default": "" }, "destinationSetlistKey", "destinationPosition", { "name": "expectedPresetName", "default": "" }, "expectedPosition", { "name": "confirmOverwrite", "default": false }] },
    { "rpc": "device.renameCurrentPreset", "target": "rename_current_preset", "client": "renameCurrentPreset", "tauri": "rename_current_preset", "args": ["name", { "name": "expectedPresetName", "default": "" }, "expectedPosition", { "name": "confirmRename", "default": false }] },
    { "rpc": "device.createBackup", "target": "create_device_backup", "client": "createDeviceBackup", "tauri": "create_device_backup", "args": [{ "name": "name", "default": "" }] },
    { "rpc": "device.showTuner", "target": "show_tuner", "client": "showTuner", "tauri": "show_tuner", "args": [{ "name": "shown", "default": true }] },
    { "rpc": "device.showGigView", "target": "show_gig_view", "client": "showGigView", "tauri": "show_gig_view", "args": [{ "name": "shown", "default": true }] }
  ]
}
